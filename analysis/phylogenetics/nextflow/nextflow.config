// Smoke-test config. Real pipeline config (per-process resource requests,
// exitReadTimeout/pollInterval tuning for multi-day Gubbins-scale jobs — see
// plan's Risks section) will extend this once the smoke test passes.

process {
    executor = 'pbs'
    queue    = 'workq'
}

apptainer {
    enabled    = true
    autoMounts = true
}

// Compute nodes only, never pne2 — enforced by process.executor = 'pbs' above
// (every process dispatches via qsub); this config has no local-executor
// fallback path.
