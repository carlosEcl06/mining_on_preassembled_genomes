// Real pipeline config. Smoke test (main.nf's earlier helloPBS/helloApptainer
// version) already validated PBS + Apptainer mechanics — see plan.

process {
    executor = 'pbs'
    queue    = 'workq'
}

apptainer {
    enabled    = true
    autoMounts = true
}

executor {
    // Per plan Risks: Nextflow's PBS executor detects completion via a
    // .exitcode sentinel file on the shared filesystem; NFS propagation lag
    // on long-running processes can trip a false failure. Raised well above
    // defaults as a preemptive measure (cheap for the Snippy fan-out, and
    // matters more once Gubbins-scale multi-day jobs are in this same
    // pipeline).
    exitReadTimeout = '270 sec'
    pollInterval    = '30 sec'
    queueSize       = 40   // cap concurrent PBS jobs, leave headroom across the 6 free nodes
}

// Compute nodes only, never pne2 — enforced by process.executor = 'pbs' above
// (every process dispatches via qsub); this config has no local-executor
// fallback path.
